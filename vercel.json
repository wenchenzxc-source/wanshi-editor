{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/cron/drive-jobs", "schedule": "0 0 * * *" }],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "public/{fonts,artwork}/**",
      "maxDuration": 300
    }
  }
}
