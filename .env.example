# Export these variables in the process environment. This file is documentation only.
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
# TEMPLATES_FILE=./templates.example.json
# REMOVEBG_API_KEY=your-real-key
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://editor.example.com
# 必填：工作室後台 /studio 的長隨機密碼；不要放進前端或提交到 Git。
# STUDIO_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Vercel + Supabase 正式部署（secret key 僅能放在 Vercel 伺服器環境變數）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# SUPABASE_STORAGE_BUCKET=wanshi-private

# WooCommerce 建站後設定。使用 WooCommerce Webhook 的同一組 Secret。
# WOOCOMMERCE_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Vercel Cron 用於補跑失敗或中斷的 Google Drive 同步工作。
# CRON_SECRET=replace-with-a-different-long-random-secret

# 個人 Google Drive OAuth。這些值僅能放在伺服器環境變數，切勿加 VITE_ 前綴。
# GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-offline-refresh-token
# GOOGLE_DRIVE_FOLDER_ID=1YHknY68xFWvuL5s7JsoY3dBwV7dyP5Gq
